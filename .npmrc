# better-sqlite3 13 trae binarios precompilados y declara "gypfile": false,
# pero npm 10 ignora ese campo al instalar desde package-lock.json y ejecuta
# "node-gyp rebuild", que en Windows exige Python y Visual Studio Build Tools.
# Ninguna dependencia necesita scripts de instalación, así que se omiten.
# "npm start", "npm test" y "npm run ..." se siguen ejecutando normalmente.
ignore-scripts=true
